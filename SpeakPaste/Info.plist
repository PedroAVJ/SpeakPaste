<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>SpeakPaste</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>speakpaste</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>sms</string>
		<string>whatsapp</string>
		<string>whatsapp-consumer</string>
		<string>instagram</string>
		<string>fb-messenger</string>
		<string>messenger</string>
		<string>mailto</string>
		<string>twitter</string>
		<string>linkedin</string>
		<string>mobilenotes</string>
		<string>onenote</string>
		<string>keep</string>
		<string>notion</string>
		<string>evernote</string>
		<string>chatgpt</string>
		<string>claude</string>
		<string>googlegemini</string>
		<string>com.grokapp</string>
		<string>kin</string>
		<string>perplexity-app</string>
		<string>goodnotes5</string>
		<string>notability</string>
		<string>bear</string>
		<string>obsidian</string>
		<string>googlechrome</string>
		<string>googlecalendar</string>
		<string>googledocs</string>
		<string>googledrive</string>
		<string>comgooglemaps</string>
		<string>googleapp</string>
		<string>microsoft-edge</string>
		<string>youtube</string>
		<string>fb</string>
		<string>tiktok</string>
		<string>reddit</string>
		<string>barcelona</string>
		<string>bluesky</string>
		<string>pinterest</string>
		<string>sgnl</string>
		<string>line</string>
		<string>ichat</string>
		<string>tg</string>
		<string>slack</string>
		<string>discord</string>
		<string>message</string>
		<string>googlegmail</string>
		<string>ms-outlook</string>
		<string>ymail</string>
		<string>superhuman</string>
		<string>protonmail</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>SpeakPaste records your voice so ElevenLabs can turn it into text.</string>
	<key>SpeakPasteAppGroupIdentifier</key>
	<string>$(SPEAKPASTE_APP_GROUP_IDENTIFIER)</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SpeakPasteSceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!-- An empty UILaunchScreen renders systemBackground, which is white on a
	     phone in light appearance. Every keyboard round trip cold-launches this
	     app, so that default flashed white between the host app and SpeakPaste's
	     dark UI. This color matches Theme.background. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
